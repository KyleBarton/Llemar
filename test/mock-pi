#!/usr/bin/env python3
"""A scriptable stand-in for `pi --mode rpc`.

Llemar's tests drive this instead of the real pi: it speaks the same JSONL
protocol but emits a fixed, named event script, so renderer behaviour can be
asserted without a model, a network call, or any cost.

Usage: mock-pi [--mode rpc] <scenario>
"""
import json
import os
import sys


def emit(record):
    # ensure_ascii=False so scenarios can carry real multibyte text.
    sys.stdout.write(json.dumps(record, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def assistant_text(deltas, index=0):
    emit({"type": "message_update", "usage": {},
          "assistantMessageEvent": {"type": "text_start", "contentIndex": index}})
    for delta in deltas:
        emit({"type": "message_update", "usage": {},
              "assistantMessageEvent": {"type": "text_delta",
                                        "contentIndex": index, "delta": delta}})
    emit({"type": "message_update", "usage": {},
          "assistantMessageEvent": {"type": "text_end", "contentIndex": index,
                                    "content": "".join(deltas)}})


def thinking(deltas, index=0):
    emit({"type": "message_update", "usage": {},
          "assistantMessageEvent": {"type": "thinking_start", "contentIndex": index}})
    for delta in deltas:
        emit({"type": "message_update", "usage": {},
              "assistantMessageEvent": {"type": "thinking_delta",
                                        "contentIndex": index, "delta": delta}})
    emit({"type": "message_update", "usage": {},
          "assistantMessageEvent": {"type": "thinking_end", "contentIndex": index,
                                    "content": "".join(deltas)}})


def tool_call(call_id, name, arguments, index):
    emit({"type": "message_update", "usage": {},
          "assistantMessageEvent": {"type": "toolcall_start", "contentIndex": index,
                                    "id": call_id, "toolName": name}})
    emit({"type": "message_update", "usage": {},
          "assistantMessageEvent": {"type": "toolcall_end", "contentIndex": index,
                                    "toolCall": {"id": call_id, "name": name,
                                                 "arguments": arguments}}})


def tool_result(call_id, name, text, is_error=False, duration=7):
    emit({"type": "tool_execution_start", "toolCallId": call_id,
          "toolName": name, "args": {}})
    emit({"type": "tool_execution_end", "toolCallId": call_id, "toolName": name,
          "result": {"content": [{"type": "text", "text": text}]},
          "isError": is_error, "durationMs": duration})


def begin():
    emit({"type": "agent_start"})
    emit({"type": "turn_start"})
    emit({"type": "message_start", "message": {"role": "assistant", "content": []}})


def end_message():
    emit({"type": "message_end", "message": {"role": "assistant", "content": []}})


def settle():
    emit({"type": "agent_end", "messages": [], "willRetry": False})
    emit({"type": "agent_settled", "aborted": False})


# Prose and tool output that collide with org syntax: a markdown bold run and
# a bullet at column 0, a stray block terminator, and a would-be headline.
HOSTILE_PROSE = ["Here is the plan.\n\n", "**Step one", "**: look around.\n",
                 "* a bullet\n"]
HOSTILE_OUTPUT = "README.md\nllemar.el\n#+end_example\n* not a heading"


def scenario_basic():
    begin()
    thinking(["Let me ", "check the repo."])
    assistant_text(HOSTILE_PROSE, index=1)
    tool_call("call_1", "bash", {"command": "ls -la"}, index=2)
    end_message()
    tool_result("call_1", "bash", HOSTILE_OUTPUT, duration=12)
    # A second turn whose text never streams: only text_end carries content.
    emit({"type": "turn_start"})
    emit({"type": "message_start", "message": {"role": "assistant", "content": []}})
    emit({"type": "message_update", "usage": {},
          "assistantMessageEvent": {"type": "text_end", "contentIndex": 0,
                                    "content": "Two files. Done."}})
    end_message()
    settle()


def scenario_title_review():
    message = {"role": "custom", "customType": "llemar-session-title-review",
               "content": "Session-title check: hidden reminder sentinel",
               "display": False}
    emit({"type": "message_start", "message": message})
    emit({"type": "message_end", "message": message})
    scenario_named()


def scenario_named():
    begin()
    emit({"type": "session_info_changed", "name": "Repository navigation"})
    assistant_text(["Done."])
    end_message()
    settle()


def scenario_parallel():
    begin()
    assistant_text(["Checking two things  right now — café 日本語 \U0001F600\n"])
    tool_call("call_a", "bash", {"command": "git status"}, index=1)
    tool_call("call_b", "read_file", {"path": "README.md"}, index=2)
    end_message()
    # Results arrive in the opposite order to the calls.
    tool_result("call_b", "read_file", "# Llemar\nAn LL(m) ema(cs) r(epl)", duration=3)
    tool_result("call_a", "bash", "\n".join("line %d" % n for n in range(1, 31)),
                is_error=True, duration=44)
    settle()


def scenario_nullargs():
    begin()
    tool_call("call_1", "read",
              {"path": "README.md", "offset": None, "limit": None,
               "recurse": False, "deep": True, "nested": {"a": 1},
               "list": [1, None, False]}, index=0)
    end_message()
    tool_result("call_1", "read", "ok")
    settle()


EDIT_PATCH = "--- a/example.el\n+++ b/example.el\n@@ -1,2 +1,2 @@\n-old\n+new\n context\n"


def messages_edit():
    messages = [{"role": "assistant", "content": []}]
    for call_id, name, error, details in [
            ("edit-ok", "edit", False, {"patch": EDIT_PATCH}),
            ("edit-error", "edit", True, {"patch": EDIT_PATCH}),
            ("edit-legacy", "edit", False, {}),
            ("other", "bash", False, {"patch": EDIT_PATCH})]:
        messages.append({"role": "toolResult", "toolCallId": call_id,
                         "toolName": name, "isError": error,
                         "content": [{"type": "text", "text": call_id}],
                         "details": details})
    return messages


def scenario_edit():
    begin()
    end_message()
    for message in messages_edit()[1:]:
        emit({"type": "tool_execution_end",
              "toolCallId": message["toolCallId"],
              "toolName": message["toolName"],
              "isError": message["isError"],
              "result": {"content": message["content"],
                         "details": message["details"]}})
    settle()


WRITE_CALLS = [
    ("write-ok", {"path": "example.el", "content": "first\nsecond\nthird\nlast  \n"}),
    ("write-error", {"path": "failed.el", "content": "not written"}),
    ("write-empty", {"path": "empty.el", "content": ""}),
    ("write-hostile", {"path": "odd\n* not a heading", "content":
                       "#+end_src\n* not a heading\n+already plus\n\n"}),
    ("write-invalid", {"path": "invalid.el", "content": 42}),
]


def messages_write():
    calls = [{"type": "toolCall", "id": call_id, "name": "write", "arguments": args}
             for call_id, args in WRITE_CALLS]
    messages = [{"role": "assistant", "content": calls}]
    for call_id, _ in WRITE_CALLS:
        messages.append({"role": "toolResult", "toolCallId": call_id,
                         "toolName": "write", "isError": call_id == "write-error",
                         "content": [{"type": "text", "text": call_id}],
                         "details": None})
    return messages


def scenario_write():
    begin()
    for index, (call_id, args) in enumerate(WRITE_CALLS):
        tool_call(call_id, "write", args, index)
    end_message()
    # No results in this scenario: rendering must not depend on success.
    settle()


def scenario_write_results():
    begin()
    for index, (call_id, args) in enumerate(WRITE_CALLS):
        tool_call(call_id, "write", args, index)
    end_message()
    for call_id, _ in reversed(WRITE_CALLS):
        tool_result(call_id, "write", call_id, is_error=call_id == "write-error")
    settle()


def scenario_retry():
    begin()
    emit({"type": "auto_retry_start", "attempt": 1, "maxAttempts": 3,
          "delayMs": 1, "errorMessage": "529 overloaded"})
    emit({"type": "auto_retry_end", "success": True, "attempt": 2})
    assistant_text(["Recovered.\n"])
    end_message()
    settle()


COMPACTION_ENTRIES = []


def compaction_result():
    return {"summary": "Remember the old exchange.\n* not a heading",
            "firstKeptEntryId": "kept", "tokensBefore": 150000,
            "estimatedTokensAfter": 32000}


def compact_event(reason):
    emit({"type": "compaction_start", "reason": reason})
    result = compaction_result()
    count = sum(entry["type"] == "compaction" for entry in COMPACTION_ENTRIES)
    entry_id = f"compact-{count + 1}"
    if scenario_name == "compact-unknown":
        result["firstKeptEntryId"] = "unavailable-boundary"
    if count or scenario_name in ("compact-auto-none", "compact-before"):
        result["firstKeptEntryId"] = entry_id  # Retain none on the second pass.
    COMPACTION_ENTRIES.append(dict(result, type="compaction", id=entry_id,
                                   parentId=COMPACTION_ENTRIES[-1]["id"],
                                   timestamp="2026-01-02T03:04:05Z"))
    emit({"type": "compaction_end", "reason": reason, "result": result,
          "aborted": False, "willRetry": reason == "overflow"})
    return result


def scenario_compaction():
    if scenario_name == "compact-before" and COMPACTION_ENTRIES:
        compact_event("threshold")
        emit({"type": "agent_start"})
        message = {"role": "user", "timestamp": 201, "content": "next prompt"}
        emit({"type": "message_start", "message": message})
        begin()
        assistant_text(["Answered next prompt.\n"])
        settle()
        return
    emit({"type": "agent_start"})
    for entry_id, role, text, timestamp in [
            ("old", "user", "go", 101),
            ("answer", "assistant", "Original answer.\n", 102),
            ("kept", "assistant", "Retained answer.\n", 103)]:
        message = {"role": role, "timestamp": timestamp,
                   "content": text if role == "user" else [{"type": "text", "text": text}]}
        COMPACTION_ENTRIES.append({"type": "message", "id": entry_id,
                                   "parentId": COMPACTION_ENTRIES[-1]["id"] if COMPACTION_ENTRIES else None,
                                   "message": message})
        emit({"type": "message_start", "message": message})
        if role == "assistant":
            assistant_text([text])
        if entry_id == "answer":
            message["content"].append({"type": "toolCall", "id": "archive-tool",
                                       "name": "bash", "arguments": {"command": "ls"}})
            tool_call("archive-tool", "bash", {"command": "ls"}, 1)
            tool_result("archive-tool", "bash", HOSTILE_OUTPUT)
        emit({"type": "message_end", "message": message})
        if entry_id == "answer":
            COMPACTION_ENTRIES.append({"type": "message", "id": "tool-result",
                                       "parentId": "answer",
                                       "message": {"role": "toolResult", "toolCallId": "archive-tool",
                                                   "toolName": "bash", "timestamp": 102.5,
                                                   "content": [{"type": "text", "text": HOSTILE_OUTPUT}]}})
    if scenario_name in ("compact-auto", "compact-auto-none"):
        compact_event("overflow")
        assistant_text(["Continued after compaction.\n"])
    settle()


def scenario_hang():
    emit({"type": "agent_start"})


# Saved transcripts returned by `get_messages' when a session is resumed.
# Each is a list of AgentMessage objects, as pi persists them.
def messages_resume():
    return [
        # A leading system message carries the prompt and tools; a client
        # rendering history must skip it, not turn it into a turn.
        {"role": "system", "content": "", "timestamp": 0},
        {"role": "user", "content": "Summarise the repo", "timestamp": 1},
        {"role": "assistant",
         "content": [
             {"type": "thinking", "thinking": "Let me look around."},
             {"type": "text", "text": "Here is the summary.\n* not a heading"},
             {"type": "toolCall", "id": "call_1", "name": "bash",
              "arguments": {"command": "ls"}}],
         "model": "mock/model", "usage": {}, "stopReason": "toolUse",
         "timestamp": 2},
        {"role": "toolResult", "toolCallId": "call_1", "toolName": "bash",
         "content": [{"type": "text", "text": "README.md\nllemar.el"}],
         "isError": False, "timestamp": 3},
        {"role": "assistant",
         "content": [{"type": "text", "text": "Two files."}],
         "model": "mock/model", "usage": {}, "stopReason": "stop",
         "timestamp": 4},
    ]


def scenario_open_buffer():
    begin()
    path = os.path.join(os.getcwd(), "mock-pi")
    for call_id, line in [("open-ok", 2), ("open-error", 999999)]:
        emit({"type": "tool_execution_start", "toolCallId": call_id,
              "toolName": "open_buffer", "args": {"path": path}})
        event = {"type": "tool_execution_end", "toolCallId": call_id,
                 "toolName": "open_buffer", "isError": False,
                 "result": {"content": [{"type": "text", "text": "Display requested."}],
                            "details": {"version": 1, "action": "open_file",
                                        "path": path, "line": line}}}
        emit(event)
        emit(event)  # Duplicate delivery must not repeat the editor action.
    end_message()
    settle()


SCENARIOS = {
    "compact-manual": scenario_compaction,
    "compact-auto": scenario_compaction,
    "compact-auto-none": scenario_compaction,
    "compact-unknown": scenario_compaction,
    "compact-before": scenario_compaction,
    "compact-fail": scenario_compaction,
    "compact-cancel": scenario_compaction,
    "compact-resume": scenario_compaction,
    "write": scenario_write,
    "write-results": scenario_write_results,
    "edit": scenario_edit,
    "open-buffer": scenario_open_buffer,
    "basic": scenario_basic,
    "named": scenario_named,
    "title-review": scenario_title_review,
    "parallel": scenario_parallel,
    "nullargs": scenario_nullargs,
    "retry": scenario_retry,
    "hang": scenario_hang,
    "resume": scenario_basic,
}

MESSAGE_SCRIPTS = {
    "write": messages_write,
    "resume": messages_resume,
    "edit": messages_edit,
}


def main():
    global scenario_name
    scenario = next((a for a in sys.argv[1:] if a in SCENARIOS), "basic")
    scenario_name = scenario
    if scenario == "compact-resume":
        # Reuse the deterministic history builder, suppressing live events.
        global emit
        original_emit = emit
        emit = lambda record: None
        scenario_compaction()
        compact_event("manual")
        emit = original_emit
    for line in sys.stdin:
        if not line.strip():
            continue
        command = json.loads(line)
        kind, request = command.get("type"), command.get("id")
        if kind == "prompt":
            emit({"id": request, "type": "response", "command": "prompt",
                  "success": True, "data": {"disposition": "started"}})
            SCENARIOS[scenario]()
        elif kind == "abort":
            emit({"id": request, "type": "response", "command": "abort",
                  "success": True})
            emit({"type": "agent_settled", "aborted": True})
        elif kind == "get_state":
            emit({"id": request, "type": "response", "command": "get_state",
                  "success": True,
                  "data": {"model": {"id": "mock/model"}, "thinkingLevel": "medium",
                           "isStreaming": False, "messageCount": 2,
                           "sessionId": "mock-123",
                           "sessionFile": "/tmp/mock-session.jsonl"}})
        elif kind == "compact":
            if scenario in ("compact-fail", "compact-cancel"):
                emit({"type": "compaction_start", "reason": "manual"})
                emit({"type": "compaction_end", "reason": "manual",
                      "aborted": scenario == "compact-cancel", "errorMessage": "Cannot compact"})
                emit({"id": request, "type": "response", "command": kind,
                      "success": False, "error": "Cannot compact"})
            else:
                result = compact_event("manual")
                emit({"id": request, "type": "response", "command": kind,
                      "success": True, "data": result})
        elif kind == "get_entries":
            emit({"id": request, "type": "response", "command": kind,
                  "success": True, "data": {"entries": COMPACTION_ENTRIES,
                  "leafId": COMPACTION_ENTRIES[-1]["id"] if COMPACTION_ENTRIES else None}})
        elif kind == "get_messages":
            builder = MESSAGE_SCRIPTS.get(scenario)
            emit({"id": request, "type": "response", "command": "get_messages",
                  "success": True,
                  "data": {"messages": builder() if builder else []}})
        elif kind == "set_model":
            emit({"id": request, "type": "response", "command": "set_model",
                  "success": False, "error": "Model not found: bogus"})
        else:
            emit({"id": request, "type": "response", "command": kind,
                  "success": True, "data": {}})


if __name__ == "__main__":
    main()
